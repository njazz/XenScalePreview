# Single source of truth for the release version. Edit this file to bump a release.
# VERSION = marketing version (CFBundleShortVersionString)
# BUILD   = build number; must increase with every App Store Connect / TestFlight upload of the same VERSION
# Either can still be overridden per run:  VERSION=1.1.0 BUILD=7 ./build_appstore.sh all
VERSION=1.0.0
BUILD=3
